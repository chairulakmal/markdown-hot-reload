[Desktop Entry]
Type=Application
Name=mhr
GenericName=Markdown Viewer
Comment=Read-only GitHub-flavoured markdown viewer that reloads on save
# snapd validates this against the app's wrapper name, markdown-hot-reload.mhr,
# and silently drops the whole line when it does not match, leaving an entry
# with no command. The bare `mhr` alias is not accepted here even once granted,
# because it is a separate symlink rather than the wrapper.
Exec=markdown-hot-reload.mhr %f
Icon=${SNAP}/meta/gui/icon.svg
Terminal=false
MimeType=text/markdown;
Categories=Utility;TextTools;
# mhr sets no GTK app id, so GTK uses the program name as the window class.
# Matching it here lets the desktop shell find this entry for the running
# window instead of falling back to a generic icon.
StartupWMClass=mhr
# mhr exits with an error when it gets no file argument, so an app-grid launch
# would always fail. NoDisplay keeps it out of the grid but leaves it in the
# "Open With" menu for markdown files, which is the only way to start it here.
NoDisplay=true
